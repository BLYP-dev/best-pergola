---
import { counties } from '@data/counties';

export interface Props {
  heading?: string;
  subheading?: string;
  eyebrow?: string;
  limit?: number;
}

const {
  heading = 'Where we cover',
  subheading,
  eyebrow = 'Locations',
  limit,
} = Astro.props;

const list = limit ? counties.slice(0, limit) : counties;
---

<section class="my-16 md:my-24">
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10">
    <div class="max-w-2xl">
      <div class="eyebrow mb-3">{eyebrow}</div>
      <h2 class="display text-3xl md:text-5xl">{heading}</h2>
      {subheading && (
        <p class="mt-4 text-base md:text-lg leading-relaxed" style="color: var(--color-mist);">
          {subheading}
        </p>
      )}
    </div>
    <a href="/locations/" class="btn btn-secondary self-start">
      Browse all counties
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
    {list.map((c) => (
      <a
        href={`/locations/${c.slug}/pergola-installers/`}
        class="group block surface px-5 py-5 transition-all hover:bg-[color:var(--color-stone-soft)] hover:-translate-y-0.5"
      >
        <div class="eyebrow text-[10px] mb-1.5">Pergola installers</div>
        <div class="font-display text-lg flex items-center justify-between" style="font-weight: 500;">
          <span>{c.name}</span>
          <svg class="opacity-0 group-hover:opacity-100 transition" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-clay);"><path d="M7 17 17 7M7 7h10v10"/></svg>
        </div>
      </a>
    ))}
  </div>
</section>
