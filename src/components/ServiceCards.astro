---
import { services } from '@data/services';

export interface Props {
  heading?: string;
  eyebrow?: string;
  limit?: number;
}

const { heading = 'Every pergola type, every budget', eyebrow = 'What we cover', limit } = Astro.props;
const list = limit ? services.slice(0, limit) : services;
---

<section class="my-16 md:my-24">
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10">
    <div class="max-w-2xl">
      <div class="eyebrow mb-3">{eyebrow}</div>
      <h2 class="display text-3xl md:text-5xl">{heading}</h2>
    </div>
    <a href="/pergola-cost/" class="btn btn-secondary self-start">
      See cost guide
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {list.map((s, i) => (
      <a
        href={`/${s.slug}/`}
        class={`group block surface p-7 transition-all hover:-translate-y-0.5 hover:shadow-[0_12px_40px_-12px_rgba(15,30,22,0.18)] ${i === 0 ? 'sm:col-span-2 lg:col-span-1' : ''}`}
      >
        <div class="flex items-start justify-between gap-3 mb-5">
          <div class="w-11 h-11 rounded-full flex items-center justify-center" style="background: var(--color-stone);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-moss);">
              <path d="M3 9h18M3 14h18M5 5v14M19 5v14M9 5v14M15 5v14" />
            </svg>
          </div>
          <span class="opacity-0 group-hover:opacity-100 transition-all -translate-x-2 group-hover:translate-x-0">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-clay);"><path d="M7 17 17 7M7 7h10v10"/></svg>
          </span>
        </div>
        <div class="font-display text-xl md:text-2xl mb-2" style="font-weight: 500;">{s.name}</div>
        <p class="text-sm leading-relaxed" style="color: var(--color-mist);">
          {s.description.slice(0, 130)}…
        </p>
        <div class="mt-6 pt-5 border-t flex items-center justify-between" style="border-color: rgba(15,30,22,0.08);">
          <span class="eyebrow">From</span>
          <span class="mono font-medium" style="color: var(--color-ink);">{s.costRange.match(/£[\d,]+/)?.[0] ?? s.costRange.split(' ')[0]}</span>
        </div>
      </a>
    ))}
  </div>
</section>
