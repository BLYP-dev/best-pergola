---
export interface Props {
  heading: string;
  subheading?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  variant?: 'home' | 'page';
  eyebrow?: string;
}

const {
  heading,
  subheading,
  primaryCta,
  secondaryCta,
  variant = 'page',
  eyebrow,
} = Astro.props;

const isHome = variant === 'home';
---

<section class={`relative overflow-hidden ${isHome ? 'pt-12 pb-16 md:pt-20 md:pb-28' : 'pt-10 pb-12 md:pt-14 md:pb-16'}`}>
  {/* Decorative background curves */}
  {isHome && (
    <>
      <div class="absolute -top-20 -right-20 w-[480px] h-[480px] rounded-full pointer-events-none opacity-50" style="background: radial-gradient(circle, var(--color-stone) 0%, transparent 70%);"></div>
      <div class="absolute -bottom-32 -left-32 w-[600px] h-[600px] rounded-full pointer-events-none opacity-40" style="background: radial-gradient(circle, var(--color-stone-soft) 0%, transparent 70%);"></div>
    </>
  )}

  <div class="container-tight relative">
    {isHome ? (
      <div class="grid lg:grid-cols-[1.4fr_1fr] gap-10 lg:gap-16 items-center">
        <div>
          {eyebrow && <div class="eyebrow mb-6 fade-up">{eyebrow}</div>}
          {!eyebrow && (
            <div class="chip mb-6 fade-up">
              <span class="chip-dot"></span>
              Trusted across 20+ UK counties
            </div>
          )}
          <h1 class="display text-[2.6rem] sm:text-6xl md:text-7xl lg:text-[5.2rem] fade-up delay-100">
            {heading}
          </h1>
          {subheading && (
            <p class="mt-7 text-lg md:text-xl max-w-xl leading-relaxed fade-up delay-200" style="color: var(--color-mist);">
              {subheading}
            </p>
          )}
          {(primaryCta || secondaryCta) && (
            <div class="mt-9 flex flex-wrap gap-3 fade-up delay-300">
              {primaryCta && (
                <a href={primaryCta.href} class="btn btn-primary btn-lg">
                  {primaryCta.label}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </a>
              )}
              {secondaryCta && (
                <a href={secondaryCta.href} class="btn btn-secondary btn-lg">{secondaryCta.label}</a>
              )}
            </div>
          )}

          {/* Inline trust strip */}
          <div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-3 text-sm fade-up delay-400" style="color: var(--color-mist);">
            <span class="inline-flex items-center gap-2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              Free, no obligation
            </span>
            <span class="inline-flex items-center gap-2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m8 12 3 3 5-6"/></svg>
              Quotes in under 2 minutes
            </span>
            <span class="inline-flex items-center gap-2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0Z"/><path d="M3.6 9h16.8M3.6 15h16.8M12 3a17 17 0 0 1 0 18M12 3a17 17 0 0 0 0 18"/></svg>
              UK-wide network
            </span>
          </div>
        </div>

        {/* Hero card with abstract pergola illustration */}
        <div class="relative fade-up delay-200">
          <div class="surface-stone p-8 md:p-10 relative overflow-hidden" style="aspect-ratio: 4/5;">
            <svg viewBox="0 0 400 500" class="absolute inset-0 w-full h-full" preserveAspectRatio="xMidYMid slice">
              <defs>
                <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#f7f1e3" />
                  <stop offset="100%" stop-color="#f1e9d8" />
                </linearGradient>
                <linearGradient id="moss" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#1c3528" />
                  <stop offset="100%" stop-color="#122418" />
                </linearGradient>
              </defs>

              {/* Sun */}
              <circle cx="305" cy="115" r="62" fill="#c47a4c" opacity="0.85" />

              {/* Pergola structure */}
              <g stroke="url(#moss)" stroke-width="6" stroke-linecap="round" fill="none">
                {/* Posts */}
                <line x1="80" y1="240" x2="80" y2="440" />
                <line x1="320" y1="240" x2="320" y2="440" />
                {/* Top beams */}
                <line x1="60" y1="240" x2="340" y2="240" stroke-width="8"/>
                <line x1="60" y1="220" x2="340" y2="220" stroke-width="8"/>
              </g>

              {/* Roof slats */}
              <g stroke="#1c3528" stroke-width="3" stroke-linecap="round">
                <line x1="95" y1="220" x2="95" y2="195" />
                <line x1="125" y1="220" x2="125" y2="195" />
                <line x1="155" y1="220" x2="155" y2="195" />
                <line x1="185" y1="220" x2="185" y2="195" />
                <line x1="215" y1="220" x2="215" y2="195" />
                <line x1="245" y1="220" x2="245" y2="195" />
                <line x1="275" y1="220" x2="275" y2="195" />
                <line x1="305" y1="220" x2="305" y2="195" />
              </g>

              {/* Ground */}
              <rect x="0" y="440" width="400" height="60" fill="#c47a4c" opacity="0.18" />

              {/* Foliage left */}
              <g fill="#1c3528" opacity="0.9">
                <circle cx="40" cy="380" r="38" />
                <circle cx="68" cy="350" r="28" />
                <circle cx="22" cy="340" r="26" />
              </g>
              {/* Foliage right */}
              <g fill="#2e4b3c" opacity="0.85">
                <circle cx="370" cy="395" r="34" />
                <circle cx="350" cy="370" r="22" />
              </g>

              {/* Furniture suggestion */}
              <rect x="155" y="370" width="90" height="50" rx="6" fill="#0f1e16" opacity="0.18" />
              <rect x="155" y="355" width="90" height="20" rx="4" fill="#c47a4c" opacity="0.6" />
            </svg>

            {/* Floating stat badge */}
            <div class="absolute top-5 left-5 surface px-4 py-3 shadow-sm">
              <div class="eyebrow text-[10px]" style="color: var(--color-mist);">Avg. install</div>
              <div class="font-display text-lg" style="font-weight: 500;">£8,400</div>
            </div>

            {/* Floating chip badge */}
            <div class="absolute bottom-5 right-5 chip" style="background: var(--color-paper);">
              <span class="chip-dot" style="background: #2c8a4a;"></span>
              Verified installers
            </div>
          </div>
        </div>
      </div>
    ) : (
      <div class="max-w-3xl">
        {eyebrow && <div class="eyebrow mb-5">{eyebrow}</div>}
        <h1 class="display text-4xl md:text-6xl lg:text-7xl">
          {heading}
        </h1>
        {subheading && (
          <p class="mt-5 text-lg md:text-xl leading-relaxed max-w-2xl" style="color: var(--color-mist);">
            {subheading}
          </p>
        )}
        {(primaryCta || secondaryCta) && (
          <div class="mt-8 flex flex-wrap gap-3">
            {primaryCta && (
              <a href={primaryCta.href} class="btn btn-primary btn-lg">
                {primaryCta.label}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </a>
            )}
            {secondaryCta && (
              <a href={secondaryCta.href} class="btn btn-secondary btn-lg">{secondaryCta.label}</a>
            )}
          </div>
        )}
      </div>
    )}
  </div>
</section>
