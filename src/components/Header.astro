<header class="sticky top-0 z-40 backdrop-blur-md bg-[color:var(--color-cream)]/80 border-b border-[color:var(--color-ink)]/5">
  <div class="container-tight">
    <div class="flex items-center justify-between h-16 md:h-20">
      <a href="/" class="flex items-baseline gap-1 group">
        <span class="font-display text-2xl md:text-[1.7rem] tracking-tight" style="font-variation-settings: 'opsz' 144, 'SOFT' 100; font-weight: 500; color: var(--color-ink);">
          Best<span style="color: var(--color-clay); font-style: italic; font-weight: 400;">Pergola</span>
        </span>
      </a>

      <nav class="hidden md:flex items-center gap-1 text-sm">
        <a href="/locations/" class="px-3 py-2 rounded-full hover:bg-[color:var(--color-stone)] transition">Locations</a>
        <a href="/pergola-cost/" class="px-3 py-2 rounded-full hover:bg-[color:var(--color-stone)] transition">Costs</a>
        <a href="/aluminium-pergolas/" class="px-3 py-2 rounded-full hover:bg-[color:var(--color-stone)] transition">Aluminium</a>
        <a href="/louvered-pergolas/" class="px-3 py-2 rounded-full hover:bg-[color:var(--color-stone)] transition">Louvered</a>
