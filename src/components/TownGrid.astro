---
import type { Town } from '@data/types';

export interface Props {
  heading?: string;
  towns: Town[];
  countySlug: string;
}

const { heading = 'Towns we cover', towns, countySlug } = Astro.props;
---

{towns.length > 0 && (
  <section class="my-12 md:my-16">
    <div class="eyebrow mb-3">Towns</div>
    <h2 class="display text-3xl md:text-5xl mb-8">{heading}</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
      {towns.map((t) => (
        <a
          href={`/locations/${countySlug}/${t.slug}/pergola-installers/`}
          class="group block surface px-5 py-5 transition-all hover:bg-[color:var(--color-stone-soft)] hover:-translate-y-0.5"
        >
          <div class="eyebrow text-[10px] mb-1.5">Pergola installers in</div>
          <div class="font-display text-lg flex items-center justify-between" style="font-weight: 500;">
            <span>{t.name}</span>
            <svg class="opacity-0 group-hover:opacity-100 transition" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-clay);"><path d="M7 17 17 7M7 7h10v10"/></svg>
          </div>
        </a>
      ))}
    </div>
  </section>
)}
