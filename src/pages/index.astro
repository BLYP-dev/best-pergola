---
import PageLayout from '@layouts/PageLayout.astro';
import Hero from '@components/Hero.astro';
import TrustBox from '@components/TrustBox.astro';
import LocationGrid from '@components/LocationGrid.astro';
import ServiceCards from '@components/ServiceCards.astro';
import CTABox from '@components/CTABox.astro';
import FAQ from '@components/FAQ.astro';
import QuoteForm from '@components/QuoteForm.astro';
import { SITE } from '@lib/site';
import { sharedFaqs } from '@data/faqs';
import { faqLd, organizationLd, websiteLd } from '@lib/jsonld';

const title = `Find Trusted Pergola Installers Near You | ${SITE.name}`;
const description = SITE.description;

const jsonLd = [organizationLd(), websiteLd(), faqLd(sharedFaqs)];
---

<PageLayout title={title} description={description} jsonLd={jsonLd}>
  <Hero
    variant="home"
    heading="Trusted pergola installers, matched to your location."
    subheading="Tell us about your project and we'll connect you with suitable pergola companies covering your area. Free, fast, no obligation."
    primaryCta={{ label: SITE.primaryCTA, href: '#quote' }}
    secondaryCta={{ label: 'Browse by location', href: '/locations/' }}
  />

  <div class="container-tight">
    {/* How it works */}
    <section class="my-16 md:my-24">
      <div class="grid lg:grid-cols-[1fr_1.6fr] gap-10 lg:gap-16 items-start">
        <div class="lg:sticky lg:top-28">
          <div class="eyebrow mb-3">How it works</div>
          <h2 class="display text-3xl md:text-5xl">A simpler way to find your installer.</h2>
          <p class="mt-5 text-base md:text-lg leading-relaxed" style="color: var(--color-mist);">
            We're not the installer. We help match UK homeowners with suitable pergola companies
            covering their area — across 20+ counties.
          </p>
          <a href="#quote" class="btn btn-primary mt-7">
            Start your quote
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>

        <div class="grid grid-cols-1 gap-4">
          <div class="surface p-7 md:p-9 flex gap-6 items-start">
            <div class="font-display text-5xl md:text-6xl flex-shrink-0" style="color: var(--color-clay); font-variation-settings: 'opsz' 144, 'SOFT' 100; font-style: italic; font-weight: 400; line-height: 1;">01</div>
            <div>
              <div class="font-display text-xl md:text-2xl mb-2" style="font-weight: 500;">Tell us about your project</div>
              <p class="text-sm md:text-base leading-relaxed" style="color: var(--color-mist);">
                Share your location, the pergola type you're considering, and your rough budget.
                Takes under two minutes.
              </p>
            </div>
          </div>

          <div class="surface p-7 md:p-9 flex gap-6 items-start">
            <div class="font-display text-5xl md:text-6xl flex-shrink-0" style="color: var(--color-clay); font-variation-settings: 'opsz' 144, 'SOFT' 100; font-style: italic; font-weight: 400; line-height: 1;">02</div>
            <div>
              <div class="font-display text-xl md:text-2xl mb-2" style="font-weight: 500;">We match you with installers</div>
              <p class="text-sm md:text-base leading-relaxed" style="color: var(--color-mist);">
                We pass your enquiry to a suitable pergola installer who covers your area.
                You stay in control.
              </p>
            </div>
          </div>

          <div class="surface p-7 md:p-9 flex gap-6 items-start">
            <div class="font-display text-5xl md:text-6xl flex-shrink-0" style="color: var(--color-clay); font-variation-settings: 'opsz' 144, 'SOFT' 100; font-style: italic; font-weight: 400; line-height: 1;">03</div>
            <div>
              <div class="font-display text-xl md:text-2xl mb-2" style="font-weight: 500;">Compare quotes and decide</div>
              <p class="text-sm md:text-base leading-relaxed" style="color: var(--color-mist);">
                Review the quote, ask questions, proceed only if it's right for you.
                No obligation at any stage.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <TrustBox />

    <LocationGrid
      eyebrow="Where we cover"
      heading="20+ UK counties, growing."
      subheading="From Berkshire and Surrey to Cheshire and Somerset — find pergola installers covering your area."
      limit={20}
    />

    <ServiceCards eyebrow="Pergola types" heading="Every pergola type, every budget." />

    {/* Cost teaser */}
    <section class="my-16 md:my-24">
      <div class="surface-stone p-8 md:p-12 grid lg:grid-cols-[1.1fr_1fr] gap-10 items-center">
        <div>
          <div class="eyebrow mb-4">Cost guide</div>
          <h2 class="display text-3xl md:text-5xl">
            How much does a pergola cost in 2026?
          </h2>
          <p class="mt-5 text-base md:text-lg leading-relaxed" style="color: var(--color-mist);">
            Most UK homeowners spend between £3,000 and £15,000 fully installed. Wooden builds
            start lower, motorised louvered aluminium pergolas with side screens push higher.
          </p>
          <a href="/pergola-cost/" class="btn btn-primary mt-7">
            Full cost guide
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>

        <div class="surface p-2">
          <div class="divide-y" style="border-color: rgba(15,30,22,0.06);">
            {[
              ['Wooden, fitted', '£1,500–£4,500'],
              ['Aluminium, fixed roof', '£4,000–£8,000'],
              ['Louvered aluminium', '£6,000–£12,000'],
              ['Motorised louvered', '£8,000–£16,000'],
              ['Premium with sides & lighting', '£12,000–£25,000+'],
            ].map(([label, range]) => (
              <div class="flex justify-between items-center px-4 md:px-6 py-4">
                <span class="text-sm md:text-base">{label}</span>
                <span class="font-display whitespace-nowrap text-base md:text-lg" style="font-weight: 500;">{range}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* Planning teaser */}
    <section class="my-16 md:my-24">
      <div class="grid lg:grid-cols-2 gap-8 items-stretch">
        <div class="surface-moss p-8 md:p-12 relative overflow-hidden">
          <svg class="absolute -right-20 -bottom-20 w-72 h-72 opacity-10 pointer-events-none" viewBox="0 0 200 200" fill="none">
            <circle cx="100" cy="100" r="90" stroke="#f1e9d8" stroke-width="1"/>
            <circle cx="100" cy="100" r="60" stroke="#f1e9d8" stroke-width="1"/>
            <circle cx="100" cy="100" r="30" stroke="#f1e9d8" stroke-width="1"/>
          </svg>
          <div class="relative">
            <div class="eyebrow mb-4" style="color: rgba(241,233,216,0.6);">Planning</div>
            <h2 class="display text-2xl md:text-4xl" style="color: var(--color-cream);">
              Do you need planning permission?
            </h2>
            <p class="mt-5 leading-relaxed" style="color: rgba(241,233,216,0.8);">
              Most pergolas in England fall under Permitted Development — no permission required —
              if they're under 2.5m high within 2m of a boundary and behind the rear of the house.
              Listed buildings, conservation areas and AONBs have stricter rules.
            </p>
            <div class="mt-7 flex flex-wrap gap-3">
              <a href="/planning-permission/" class="btn btn-cream">Full planning guide</a>
              <a href="/pergola-height-rules/" class="btn btn-secondary" style="color: var(--color-cream); border-color: rgba(241,233,216,0.25);">Height rules</a>
            </div>
          </div>
        </div>

        <div class="surface-stone p-8 md:p-12 relative overflow-hidden">
          <div class="eyebrow mb-4">Timeline</div>
          <h2 class="display text-2xl md:text-4xl">
            How long does a pergola take?
          </h2>
          <p class="mt-5 leading-relaxed" style="color: var(--color-mist);">
            On-site installation: 1–3 days for a standard build, 2–5 days for motorised louvered
            with side screens. Lead times from order to install: typically 4–10 weeks.
          </p>

          <div class="mt-7 grid grid-cols-2 gap-3">
            <div class="surface p-4">
              <div class="eyebrow text-[10px] mb-1">On site</div>
              <div class="font-display text-2xl" style="font-weight: 500;">1–5 days</div>
            </div>
            <div class="surface p-4">
              <div class="eyebrow text-[10px] mb-1">Lead time</div>
              <div class="font-display text-2xl" style="font-weight: 500;">4–10 wks</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <FAQ heading="Common pergola questions" faqs={sharedFaqs} />

    <CTABox
      heading="Ready to compare pergola installers?"
      subheading="Get free, no-obligation quotes from suitable installers covering your area."
    />

    <QuoteForm />
  </div>
</PageLayout>
