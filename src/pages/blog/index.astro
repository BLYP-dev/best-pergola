---
import { SITE } from '@lib/site';

const target = '/journal/';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={`${SITE.url}${target}`} />
    <title>Journal | {SITE.name}</title>
  </head>
  <body>
    <p><a href={target}>Continue to the BestPergola journal</a>.</p>
  </body>
</html>
