---
import PageLayout from '@layouts/PageLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import TownGrid from '@components/TownGrid.astro';
import NearbyLocations from '@components/NearbyLocations.astro';
import CTABox from '@components/CTABox.astro';
import FAQ from '@components/FAQ.astro';
import QuoteForm from '@components/QuoteForm.astro';
import CostTable from '@components/CostTable.astro';
import { counties } from '@data/counties';
import { townsByCounty } from '@data/towns';
import { sharedFaqs } from '@data/faqs';
import { faqLd, localAreaLd } from '@lib/jsonld';

export function getStaticPaths() {
  return counties.map((c) => ({ params: { county: c.slug }, props: { county: c } }));
}

const { county } = Astro.props;
const towns = townsByCounty(county.slug);

const pageUrl = `/locations/${county.slug}/pergola-installers/`;
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Locations', url: '/locations/' },
  { name: county.name, url: pageUrl },
];

const jsonLd = [
  faqLd(sharedFaqs),
  localAreaLd({
    name: `Pergola Installers in ${county.name}`,
    description: county.intro,
    url: pageUrl,
    areaName: county.name,
  }),
];

const costRows = [
  { label: 'Wooden, fitted', range: '£1,500 – £4,500' },
  { label: 'Aluminium, fixed roof', range: '£4,000 – £8,000' },
  { label: 'Louvered aluminium', range: '£6,000 – £12,000' },
  { label: 'Motorised louvered', range: '£8,000 – £16,000' },
  { label: 'Premium with sides & lighting', range: '£12,000 – £25,000+' },
];

const typeCards = [
  { slug: 'aluminium-pergolas', name: 'Aluminium pergolas', body: 'Low maintenance, weatherproof, lasts 20+ years.' },
  { slug: 'louvered-pergolas', name: 'Louvered pergolas', body: 'Adjustable roof blades — sun, shade or rain cover on demand.' },
  { slug: 'motorised-pergolas', name: 'Motorised pergolas', body: 'Remote, app or sensor control with rain protection.' },
  { slug: 'garden-pergolas', name: 'Garden pergolas', body: 'Freestanding builds for lawns, dining areas, hot tubs.' },
];
---

<PageLayout
  title={county.metaTitle}
  description={county.metaDescription}
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <div class="container-tight py-10 md:py-14">
    <Breadcrumbs items={breadcrumbs} />

    <div class="grid lg:grid-cols-[1.5fr_1fr] gap-10 lg:gap-16 items-start">
      <div>
        <div class="chip mb-5">
          <span class="chip-dot"></span>
          {county.name}
        </div>
        <h1 class="display text-4xl md:text-6xl lg:text-7xl">
          Pergola installers in {county.name}.
        </h1>
        <p class="mt-6 text-lg leading-relaxed" style="color: var(--color-mist);">{county.intro}</p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#quote" class="btn btn-primary btn-lg">
            Get free quotes in {county.name}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a href="/pergola-cost/" class="btn btn-secondary btn-lg">See pergola costs</a>
        </div>
      </div>

      {/* Quick facts panel */}
      <div class="surface-stone p-7 md:p-9">
        <div class="eyebrow mb-4">{county.name} at a glance</div>
        <dl class="space-y-5">
          <div>
            <dt class="text-xs uppercase tracking-wider mb-1" style="color: var(--color-mist);">Towns covered</dt>
            <dd class="font-display text-3xl" style="font-weight: 500;">{towns.length || '20+'}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wider mb-1" style="color: var(--color-mist);">Typical install</dt>
            <dd class="font-display text-2xl" style="font-weight: 500;">£6,000–£14,000</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wider mb-1" style="color: var(--color-mist);">Lead time</dt>
            <dd class="font-display text-2xl" style="font-weight: 500;">4–10 weeks</dd>
          </div>
        </dl>
      </div>
    </div>

    {towns.length > 0 && (
      <TownGrid heading={`Towns we cover in ${county.name}`} towns={towns} countySlug={county.slug} />
    )}

    <CostTable heading={`Average pergola cost in ${county.name}`} rows={costRows} />

    <section class="my-12 md:my-16">
      <div class="eyebrow mb-3">Pergola types</div>
      <h2 class="display text-3xl md:text-4xl mb-8">Popular in {county.name}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {typeCards.map((t) => (
          <a href={`/${t.slug}/`} class="group surface p-7 flex items-start justify-between gap-4 hover:bg-[color:var(--color-stone-soft)] transition-all hover:-translate-y-0.5">
            <div>
              <div class="font-display text-xl md:text-2xl mb-2" style="font-weight: 500;">{t.name}</div>
              <p class="text-sm leading-relaxed" style="color: var(--color-mist);">{t.body}</p>
            </div>
            <svg class="flex-shrink-0 opacity-30 group-hover:opacity-100 group-hover:-translate-y-1 group-hover:translate-x-1 transition" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-clay);"><path d="M7 17 17 7M7 7h10v10"/></svg>
          </a>
        ))}
      </div>
    </section>

    <section class="my-12 grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="surface p-7">
        <div class="w-11 h-11 rounded-full flex items-center justify-center mb-5" style="background: var(--color-stone);">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-moss);"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        </div>
        <h3 class="font-display text-xl md:text-2xl mb-2" style="font-weight: 500;">Installation timeline in {county.name}</h3>
        <p class="leading-relaxed" style="color: var(--color-mist);">
          Most pergola installations in {county.name} take 1–3 days on site for a standard build,
          or 2–5 days for larger motorised louvered systems. Lead times from order to installation
          are typically 4–10 weeks depending on the season.
        </p>
      </div>
      <div class="surface p-7">
        <div class="w-11 h-11 rounded-full flex items-center justify-center mb-5" style="background: var(--color-stone);">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-moss);"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h3 class="font-display text-xl md:text-2xl mb-2" style="font-weight: 500;">Planning permission in {county.name}</h3>
        <p class="leading-relaxed" style="color: var(--color-mist);">
          Most pergolas in {county.name} fall under Permitted Development. Listed buildings,
          conservation areas and AONBs have stricter rules — check with your local planning
          authority before installation.
        </p>
        <a href="/planning-permission/" class="inline-flex items-center gap-1.5 mt-4 text-sm font-medium underline" style="color: var(--color-moss); text-underline-offset: 3px;">
          Full planning guide →
        </a>
      </div>
    </section>

    <NearbyLocations type="counties" slugs={county.nearbyCounties} />

    <FAQ heading={`Pergola FAQs for ${county.name}`} faqs={sharedFaqs} />

    <CTABox
      heading={`Ready to compare pergola installers in ${county.name}?`}
      subheading="Free, no-obligation quotes from suitable installers covering your area."
    />

    <QuoteForm
      heading={`Get Free Pergola Quotes in ${county.name}`}
      defaultCounty={county.name}
    />
  </div>
</PageLayout>
